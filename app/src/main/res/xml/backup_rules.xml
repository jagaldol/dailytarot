<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower. Readings and settings are backed up; the Lifebase folder grant is
     device-specific and must be linked again after a restore. -->
<full-backup-content>
    <include domain="database" path="readings.db" />
    <include domain="file" path="datastore/settings.preferences_pb" />
    <include domain="file" path="datastore/tarot_prefs.preferences_pb" />
</full-backup-content>
