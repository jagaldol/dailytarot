<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Same scope as backup_rules.xml: no folder grants or WorkManager state. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="readings.db" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="datastore/tarot_prefs.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="readings.db" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="datastore/tarot_prefs.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
